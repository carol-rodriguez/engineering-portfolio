---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active: "index" | "projects" | "research" | "experience" | "resume" | "contact";
}

const { title, description, active } = Astro.props;

const NAV = [
  { href: "/", key: "index", label: "About" },
  { href: "/projects", key: "projects", label: "Engineering" },
  { href: "/research", key: "research", label: "Research" },
  { href: "/experience", key: "experience", label: "Leadership" },
  { href: "/resume", key: "resume", label: "Resume" },
  { href: "/contact", key: "contact", label: "Contact" },
] as const;

const sheetNumber = NAV.findIndex((n) => n.key === active) + 1;
const total = NAV.length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Carol Rodriguez</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <header class="titleblock">
    <div class="titleblock-inner">
      <div class="tb-brand">
        <a href="/"><span class="tb-name">CAROL S. RODRIGUEZ</span></a>
        <span class="tb-role">Mechanical Engineering Student</span>
      </div>
      <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">MENU</button>
      <nav class="tb-nav" id="site-nav" aria-label="Primary">
        {NAV.map((item) => (
          <a href={item.href} aria-current={item.key === active ? "page" : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="tb-sheet">SHEET <strong>{sheetNumber}</strong> / {total} · REV. 01</div>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <footer class="titleblock-footer">
    <div class="tbf-inner">
      <span>© <span id="year"></span> Carol S. Rodriguez Esquivel · Drawn to build things that work.</span>
      <span>
        <a href="mailto:carolrodriguezcoll@gmail.com">Email</a>
        <a href="https://github.com/your-username" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/carol-rodriguez-/" target="_blank" rel="noopener">LinkedIn ↗</a>
      </span>
    </div>
  </footer>

  <script>
    const navToggle = document.querySelector(".nav-toggle");
    const tbNav = document.querySelector(".tb-nav");
    if (navToggle && tbNav) {
      navToggle.addEventListener("click", () => {
        const isOpen = tbNav.classList.toggle("open");
        navToggle.setAttribute("aria-expanded", String(isOpen));
        navToggle.textContent = isOpen ? "CLOSE" : "MENU";
      });
      tbNav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          tbNav.classList.remove("open");
          navToggle?.setAttribute("aria-expanded", "false");
          if (navToggle) navToggle.textContent = "MENU";
        });
      });
    }
    const yearEl = document.getElementById("year");
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());
  </script>
</body>
</html>
