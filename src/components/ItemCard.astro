---
interface Props {
  href: string;
  meta: string; // e.g. "Project · Jan 2026 — May 2026"
  title: string;
  summary: string;
  tags: string[];
  category?: string; // used for client-side filtering (Projects page)
  externalLinks?: { label: string; url: string }[];
}
const { href, meta, title, summary, tags, category, externalLinks = [] } = Astro.props;
---

<article class="card" data-category={category}>
  <span class="meta">{meta}</span>
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  <div class="tags">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <div class="card-links">
    <a href={href}>Read more →</a>
    {externalLinks.map((l) => (
      <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
    ))}
  </div>
</article>
